# =============================================================================
# Репетитор на Google ADK + RouterAI — пример конфигурации.
# Скопируйте файл в `.env` и заполните значения. `.env` НЕ коммитить!
# =============================================================================

# --- RouterAI (единственный обязательный ключ) ---------------------------------
# Ключ создаётся на https://routerai.ru/settings/keys
ROUTERAI_API_KEY=sk-routerai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Базовый URL OpenAI-совместимого API RouterAI
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# --- Модели по ролям (id из каталога https://routerai.ru/models) ---------------
# ВАЖНО: НЕ ставьте «рассуждающие» (reasoning) модели на planner/fast — они
# отдают ответ в канал reasoning и оставляют content пустым, из-за чего ADK
# возвращает ошибку MODEL_RETURNED_NO_CONTENT. Примеры таких моделей:
# deepseek/deepseek-v4-flash-0731, qwen/qwen3-30b-a3b, qwen/qwen3.5-9b.
# Также НЕ используйте id с префиксом openai/... (например openai/gpt-4o-mini):
# на пути ADK LiteLlm с custom_llm_provider="openai" litellm срезает префикс
# openai/ и RouterAI не находит модель. Работают vendor-префиксные id:
# deepseek/..., qwen/..., google/..., meta-llama/...
# Проверенные модели с tool-calling: deepseek/deepseek-v3.2,
# qwen/qwen-2.5-72b-instruct, google/gemini-2.5-flash,
# meta-llama/llama-3.3-70b-instruct.
# planner — сложные объяснения / ведение диалога (tools, без reasoning)
TUTOR_MODEL_PLANNER=deepseek/deepseek-v3.2
# fast — выжимка урока, черновики / поиск (дёшево, без reasoning)
TUTOR_MODEL_FAST=deepseek/deepseek-v3.2
# judge — модель «Решения» для оценки ответов ученика и маршрутизации
TUTOR_MODEL_JUDGE=~typesafe/jev-latest

# --- Поведение инструментов ----------------------------------------------------
# Лимит входных символов контекста для выжимки/квиза
TOOL_MAX_CONTEXT_CHARS=4000
# Лимит токенов ответа генератора квиза
QUIZ_MAX_TOKENS=500
# Сколько раз перегенерировать квиз при провале валидации, затем переключиться на practice
QUIZ_REJECT_CAP=2

# --- Слой приложения (тонкий лончер поверх ADK `web=True`) ----------------------
APP_HOST=127.0.0.1
APP_PORT=8080
# Перезапуск при изменении кода (uvicorn --reload): 1 — вкл, 0 — выкл
APP_RELOAD=1
# Язык репетитора (используется фронтендом для STT/TTS)
TUTOR_LANG=ru-RU

# --- Хранилище сессий ADK (опционально) ------------------------------------------
# Пусто = in-memory (сессии теряются при перезапуске).
# Для сохранения истории: sqlite:///sessions.db
TUTOR_SESSION_SERVICE_URI=

# --- Доп. CORS-origins через запятую (опционально) -------------------------------
# Нужно только если фронтенд открывается с другого origin, а не смонтирован на /tutor.
# Пример: http://localhost:5173,http://127.0.0.1:5173
TUTOR_ALLOW_ORIGINS=
